<?xml version="1.0" encoding="utf-8"?>
<!--
  Allows Capacitor's WebView to load assets from http://localhost (the internal
  asset server) on Android 9+ where cleartext HTTP is blocked by default.
  External cleartext traffic is still blocked — only localhost is permitted.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
